{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/filmes.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/filmes.html",
      "destination": "/frontend/filmes.html"
    },
    {
      "source": "/cadastro.html",
      "destination": "/frontend/cadastro.html"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/config.js",
      "destination": "/frontend/config.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    }
  ]
}